{
  "name": "stroligo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "predev": "npm run sync:assets && npm run sync:content",
    "dev": "nuxt dev",
    "dev:stop": "node scripts/dev-stop.mjs",
    "prepare:nuxt": "nuxt prepare",
    "generate:resume": "playwright install chromium && tsx scripts/generate-resume.ts",
    "sync:assets": "npm run sync:resume && npm run optimize:assets",
    "sync:resume": "mkdir -p public/profile && cp -f profile/gabriel-stroligo-cv-en.pdf public/profile/gabriel-stroligo-cv-en.pdf && cp -f profile/gabriel-stroligo-cv-pt.pdf public/profile/gabriel-stroligo-cv-pt.pdf && cp -f profile/gabriel-stroligo-cv-es.pdf public/profile/gabriel-stroligo-cv-es.pdf",
    "sync:photo": "npm run optimize:assets",
    "optimize:assets": "tsx scripts/optimize-assets.ts",
    "sync:projects": "tsx scripts/sync-project-images.ts",
    "sync:screenshots": "tsx scripts/capture-project-screenshots.ts",
    "sync:content": "tsx scripts/sync-content-from-locales.ts",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "pregenerate": "npm run sync:assets && npm run sync:content && npm run generate:sitemap",
    "prebuild": "npm run optimize:assets && npm run generate:sitemap",
    "generate": "nuxt generate",
    "postgenerate": "tsx scripts/patch-static-seo.ts",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@nuxt/content": "^3.14.0",
    "@nuxtjs/i18n": "^10.4.0",
    "nuxt": "^3.21.10",
    "nuxt-studio": "^1.7.0",
    "simple-icons": "^16.21.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "playwright": "^1.52.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@nuxtjs/mdc": "0.22.2",
    "@ai-sdk/provider-utils": "4.0.33",
    "brace-expansion": "5.0.12",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2",
    "sharp": "0.35.5",
    "simple-git": "4.0.2",
    "@simple-git/argv-parser": "2.0.1",
    "source-map-js": "1.2.2",
    "socket.io-parser": "4.2.7",
    "svgo": "4.1.0",
    "ws": "8.21.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
