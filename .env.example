# Google Search Console — meta tag de verificação (HTML tag method)
# Copie o valor do painel GSC (só o token, sem aspas)
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 — measurement ID (opcional; padrão: G-WX1TM6MRMQ)
NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Nuxt Studio — publicar conteúdo em produção (GitHub OAuth)
# Crie uma OAuth App: https://github.com/settings/developers
# Homepage URL: https://stroligo.dev  |  Callback: https://stroligo.dev/api/studio/auth/github/callback
# Em dev local, callback: http://localhost:3000/api/studio/auth/github/callback
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
