# Hostinger / Apache — canonical host + SEO
ErrorDocument 404 /404.html

# Nuxt Content SQLite (and other assets) — correct MIME types
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/javascript .mjs
  AddType application/json .json
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical: https://stroligo.dev (sem www, sempre HTTPS)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://stroligo.dev%{REQUEST_URI} [R=301,L]
</IfModule>
